{
  "description": "Run external validation vectors against the shipping primitives. CAVP00..15 include NIST AES-GCM/CBC/CCM, SHA-256 and HMAC vectors plus generated/RFC HKDF, PBKDF2, RSA-PSS and X25519 coverage. The calculator writes CAVPOUT and the host grader checks every response.",
  "transfer_files": [
    "bin/XCAVP.8xp",
    "../../common/clibs.8xg",
    "../../common/lwIPINST.8xp",
    "../../common/LWIP.0.8xv",
    "../../common/LWIP.1.8xv",
    "../../common/LWIP.2.8xv",
    "../../common/LWIP.3.8xv",
    "../../common/LWIP.4.8xv",
    "../../common/LWIP.5.8xv",
    "../../common/LWIP.6.8xv",
    "../../common/lwip.8xv",
    "../../common/lwIPCERT.8xv",
    "vectors/CAVP00.8xv",
    "vectors/CAVP01.8xv",
    "vectors/CAVP02.8xv",
    "vectors/CAVP03.8xv",
    "vectors/CAVP04.8xv",
    "vectors/CAVP05.8xv",
    "vectors/CAVP06.8xv",
    "vectors/CAVP07.8xv",
    "vectors/CAVP08.8xv",
    "vectors/CAVP09.8xv",
    "vectors/CAVP10.8xv",
    "vectors/CAVP11.8xv",
    "vectors/CAVP12.8xv",
    "vectors/CAVP13.8xv",
    "vectors/CAVP14.8xv",
    "vectors/CAVP15.8xv"
  ],
  "target": {
    "name": "XCAVP",
    "isASM": true
  },
  "sequence": [
    "key|clear",
    "action|launch:INSTALL",
    "hashWait|2",
    "key|left",
    "key|enter",
    "delay|1000",
    "action|launch",
    "hashWait|1",
    "key|enter",
    "delay|2000",
    "saveVar|CAVPOUT"
  ],
  "hashes": {
    "1": {
      "description": "CAVP runner completes (all vectors dispatched and CAVPOUT written)",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "13764DFC"
      ],
      "timeout": 60000000
    },
      "2": {
      "description": "lwIP installed",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@lwip_installed",
      "expected_CRCs": [
        "F7C03D8D"
      ],
      "timeout": 100000
    }
  }
}
