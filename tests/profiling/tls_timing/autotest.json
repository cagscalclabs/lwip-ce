{
  "description": "Verify timing behavior with two checks per primitive: (A) Stability (same input repeated, stddev <1% of mean) and (B) Differential timing across best/worst/random/edge classes, failing only for consistent inter-class cycle deltas above configured limits.",
  "transfer_files": [
    "bin/TIMINGS.8xp",
    "clibs.8xg"
  ],
  "target": {
    "name": "TIMINGS",
    "isASM": true
  },
  "sequence": [
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter",
    "hashWait|3",
    "key|enter",
    "hashWait|4",
    "key|enter",
    "hashWait|5",
    "key|enter",
    "hashWait|6",
    "key|enter",
    "hashWait|7",
    "key|enter",
    "hashWait|8",
    "key|enter",
    "hashWait|9",
    "key|enter",
    "hashWait|10",
    "key|enter",
    "hashWait|11",
    "key|enter",
    "hashWait|12",
    "key|enter",
    "hashWait|13",
    "key|enter",
    "delay|2000"
  ],
  "hashes": {
    "1": {
      "description": "RNG timing, differential",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "918A1AD3"
      ],
      "timeout": 10000000
    },
    "2": {
      "description": "Secure bytes compare, differential",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "A42E20CA"
      ],
      "timeout": 4000000
    },
    "3": {
      "description": "SHA-256, differential",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "F54D6729"
      ],
      "timeout": 2000000
    },
    "4": {
      "description": "HMAC-SHA-256, differential",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "CA34DEB6"
      ],
      "timeout": 2000000
    },
    "5": {
      "description": "HKDF, differential",
      "start": "vram_start",
