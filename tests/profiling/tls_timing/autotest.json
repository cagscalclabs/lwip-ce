{
  "description": "Verify timing behavior. Compute acceptible jitter-based cycle deviation based on MAD, a tuning factor (c), then test that no input class exceeds the acceptable deviation more than 75% of the time",
  "transfer_files": [
    "bin/TIMINGS.8xp",
    "clibs.8xg"
  ],
  "target": {
    "name": "TIMINGS",
    "isASM": true
  },
  "sequence": [
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter",
    "hashWait|3",
    "key|enter",
    "hashWait|4",
    "key|enter",
    "hashWait|5",
    "key|enter",
    "hashWait|6",
    "key|enter",
    "hashWait|7",
    "key|enter",
    "hashWait|8",
    "key|enter",
    "hashWait|9",
    "key|enter",
    "hashWait|10",
    "key|enter",
    "hashWait|11",
    "key|enter",
    "hashWait|12",
    "key|enter",
    "delay|2000",
    "saveVar|TLSTMLOG"
  ],
  "hashes": {
    "1": {
      "description": "Secure bytes compare, differential",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "A42E20CA"
      ],
      "timeout": 4000000
    },
    "2": {
      "description": "SHA-256, differential",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "F54D6729"
      ],
      "timeout": 2000000
    },
    "3": {
      "description": "HMAC-SHA-256, differential",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "CA34DEB6"
      ],
