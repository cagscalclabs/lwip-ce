        "BBA2725D"
      ],
      "timeout": 2000
    },
    "3": {
      "description": "Verify hash lookup ok",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "78FA562E"
      ],
      "timeout": 2000
    }
  }
