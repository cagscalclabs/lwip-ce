{
  "description": "Test AES cipher in GCM, CBC, and CCM modes",
  "transfer_files": [
    "bin/XAES.8xp",
    "../../common/clibs.8xg",
    "../../common/lwIPCERT.8xv",
    "../../common/lwIPINST.8xp",
    "../../common/lwIP.0.8xv",
    "../../common/lwIP.1.8xv",
    "../../common/lwIP.2.8xv",
    "../../common/lwIP.3.8xv",
    "../../common/lwIP.4.8xv",
    "../../common/lwIP.5.8xv",
    "../../common/lwip.8xv"
  ],
  "target": {
    "name": "XAES",
    "isASM": true
  },
  "sequence": [
    "key|clear",
    "key|2nd",
    "key|0",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|enter",
    "key|prgm",
    "key|1",
    "key|enter",
    "key|enter",
    "hashWait|10",
    "key|left",
    "key|enter",
    "delay|1000",
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter",
    "hashWait|3",
    "key|enter",
    "hashWait|4",
    "key|enter",
    "hashWait|5",
    "key|enter",
    "hashWait|6",
    "key|enter",
    "hashWait|7",
    "key|enter",
    "hashWait|8",
    "key|enter",
    "hashWait|9",
    "key|enter",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "GCM Spec (McGrew/Viega), Appendix B, Test Case 4",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 3500
    },
    "2": {
      "description": "GCM Spec (McGrew/Viega), Appendix B, Test Case 4",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 1500
    },
    "3": {
      "description": "NIST SP 800-38A, Appendix F.2.1, CBC-AES128.Encrypt",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 1500
    },
    "4": {
      "description": "NIST SP 800-38A, Appendix F.2.1, CBC-AES128.Decrypt",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 1500
    },
    "5": {
      "description": "RFC 3610, Section 8, AES-CCM Packet Vector #1 (encrypt)",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 1500
    },
    "6": {
      "description": "RFC 3610, Section 8, AES-CCM Packet Vector #1 (decrypt)",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 1500
    },
    "7": {
      "description": "RFC 3610, Section 8, AES-CCM Packet Vector #2 (encrypt)",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 1500
    },
    "8": {
      "description": "RFC 3610, Section 8, AES-CCM Packet Vector #2 (decrypt)",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 1500
    },
    "9": {
      "description": "RFC 3610, Section 8, AES-CCM Packet Vector #2 (bad tag zeroes plaintext)",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 1500
    },
    "10": {
      "description": "lwIP installed",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "F7C03D8D"
      ],
      "timeout": 100000
    }
  }
}
