{
  "description": "RSA-PSS signature verification using a known signature and public key",
  "transfer_files": [
    "bin/XPSSSIG.8xp"
  ],
  "target": {
    "name": "XPSSSIG",
    "isASM": false
  },
  "sequence": [
    "delay|3000",
    "action|launch",
    "delay|2000",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "RSA-2048-PSS signature verify - success",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "05A97866"
      ],
      "timeout": 100000
    },
    "2": {
      "description": "RSA-4096-PSS signature verify - success",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "AADE5EDA"
      ],
      "timeout": 100000
    }
  }
}
