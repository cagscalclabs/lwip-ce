{
  "description": "RSA-PSS signature verification using a known signature and public key",
  "transfer_files": [
    "bin/XPSSSIG.8xp",
     "../../common/clibs.8xg",
    "../../common/lwIPCERT.8xv",
    "../../common/lwIPINST.8xp",
    "../../common/LWIP.0.8xv",
    "../../common/LWIP.1.8xv",
    "../../common/LWIP.2.8xv",
    "../../common/LWIP.3.8xv",
    "../../common/LWIP.4.8xv",
    "../../common/LWIP.5.8xv",
    "../../common/LWIP.6.8xv",
    "../../common/lwip.8xv"
  ],
  "target": {
    "name": "XPSSSIG",
    "isASM": true
  },
  "sequence": [
    "key|clear",
    "action|launch:INSTALL",
    "hashWait|2",
    "key|left",
    "key|enter",
    "delay|1000",
    "action|launch",
    "hashWait|1",
    "key|enter",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "RSA-2048-PSS signature verify - RFC 8017 SHA-256, OpenSSL-generated",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "63C8DC8B"
      ],
      "timeout": 15000
    },
    "2": {
      "description": "lwIP installed",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@lwip_installed",
      "expected_CRCs": [
        "F7C03D8D"
      ],
      "timeout": 100000
    }
  }
}
