{
  "description": "Test tls_key dispatch layer (verify, sign, encrypt, decrypt)",
  "transfer_files": [
    "bin/XKEY.8xp"
  ],
  "target": {
    "name": "XKEY",
    "isASM": true
  },
  "sequence": [
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter",
    "hashWait|3",
    "key|enter",
    "hashWait|4",
    "key|enter",
    "hashWait|5",
    "key|enter",
    "hashWait|6",
    "key|enter",
    "hashWait|7",
    "key|enter",
    "hashWait|8",
    "key|enter",
    "hashWait|9",
    "key|enter",
    "hashWait|10",
    "key|enter",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "AES-128-GCM round-trip, no AAD",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 65000
    },
    "2": {
      "description": "AES-128-GCM round-trip with AAD",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "3": {
      "description": "AES-256-GCM round-trip with AAD",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "4": {
      "description": "AES-128-GCM bad tag \u2014 decrypt must return false",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "5": {
      "description": "AES-128-CCM round-trip with AAD (RFC 3610 Packet Vector #1 key)",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "6": {
      "description": "AES-128-CBC round-trip, no AAD (NIST SP 800-38A F.2.1 key)",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "7": {
      "description": "AES-256-CBC round-trip, no AAD (NIST SP 800-38A F.2.5 key)",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "8": {
      "description": "tls_key_sign: RSA\u2192UNSUPPORTED, ECDSA public-only\u2192INVALID, enc-alg\u2192UNKNOWN",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "9": {
      "description": "tls_key_verify with encryption-range alg returns TLS_KEY_OP_UNKNOWN",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "10": {
      "description": "P-384 keys API import/sign/verify/tamper",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 120000
    }
  }
}