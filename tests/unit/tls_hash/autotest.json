{
  "description": "Test TLS_HASH primitive",
  "transfer_files": [
    "bin/XHASH.8xp",
    "../../common/clibs.8xg",
    "../../common/lwIPINST.8xp",
    "../../common/LWIP.0.8xv",
    "../../common/LWIP.1.8xv",
    "../../common/LWIP.2.8xv",
    "../../common/LWIP.3.8xv",
    "../../common/LWIP.4.8xv",
    "../../common/LWIP.5.8xv",
    "../../common/LWIP.6.8xv",
    "../../common/LWIP.7.8xv",
    "../../common/LWIP.8.8xv",
    "../../common/lwip.8xv"
  ],
  "target": {
    "name": "XHASH",
    "isASM": true
  },
  "sequence": [
    "delay|10000",
    "key|clear",
    "action|launch:INSTALL",
    "hashWait|13",
    "key|left",
    "key|enter",
    "delay|1000",
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter",
    "hashWait|3",
    "key|enter",
    "hashWait|4",
    "key|enter",
    "hashWait|5",
    "key|enter",
    "hashWait|6",
    "key|enter",
    "hashWait|7",
    "key|enter",
    "hashWait|8",
    "key|enter",
    "hashWait|9",
    "key|enter",
    "hashWait|10",
    "key|enter",
    "hashWait|11",
    "key|enter",
    "hashWait|12",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "SHA-256 short message 'abc' - NIST FIPS 180-4, Example 1",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 30000
    },
    "2": {
      "description": "SHA-256 empty message - NIST FIPS 180-4, Empty String",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "3": {
      "description": "SHA-256 two-block message - NIST FIPS 180-4, Example 2",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "4": {
      "description": "SHA-384 short message 'abc' - NIST FIPS 180-4",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 60000
    },
    "5": {
