{
  "description": "Test TLS_HASH primitive",
  "transfer_files": [
    "bin/XHASH.8xp"
  ],
  "target": {
    "name": "XHASH",
    "isASM": true
  },
  "sequence": [
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter",
    "hashWait|3",
    "key|enter",
    "hashWait|4",
    "key|enter",
    "hashWait|5",
    "key|enter",
    "hashWait|6",
    "key|enter",
    "hashWait|7",
    "key|enter",
    "hashWait|8",
    "key|enter",
    "hashWait|9",
    "key|enter",
    "hashWait|10",
    "key|enter",
    "hashWait|11",
    "key|enter",
    "hashWait|12",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "SHA-256 short message 'abc' - NIST FIPS 180-4, Example 1",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 30000
    },
    "2": {
      "description": "SHA-256 empty message - NIST FIPS 180-4, Empty String",
      "start": "vram_start",
      "size": "vram_16_size",
