{
  "description": "Tests OAEP primitive standalone",
  "transfer_files": [
    "bin/XOAEP.8xp",
     "../../common/clibs.8xg",
    "../../common/lwIPCERT.8xv",
    "../../common/lwIPINST.8xp",
    "../../common/LWIP.0.8xv",
    "../../common/LWIP.1.8xv",
    "../../common/LWIP.2.8xv",
    "../../common/LWIP.3.8xv",
    "../../common/LWIP.4.8xv",
    "../../common/LWIP.5.8xv",
    "../../common/LWIP.6.8xv",
    "../../common/lwip.8xv"
  ],
  "target": {
    "name": "XOAEP",
    "isASM": true
  },
  "sequence": [
    "key|clear",
    "action|launch:INSTALL",
    "hashWait|3",
    "key|left",
    "key|enter",
    "delay|1000",
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "RSA-OAEP encode - RFC 8017 (PKCS#1 v2.2) SHA-256",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "806269A3"
      ],
      "timeout": 11000
    },
    "2": {
      "description": "RSA-OAEP decode - RFC 8017 (PKCS#1 v2.2) SHA-256",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "A428EA0F"
      ],
      "timeout": 2000
    },
    "3": {
      "description": "lwIP installed",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@lwip_installed",
      "expected_CRCs": [
        "F7C03D8D"
      ],
      "timeout": 100000
    }
  }
}
