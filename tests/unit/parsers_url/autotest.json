{
  "description": "URL percent-encode/decode and query string builder correctness",
  "transfer_files": [
    "bin/XURL.8xp",
    "../../common/clibs.8xg",
    "../../common/lwIPCERT.8xv",
    "../../common/lwIPINST.8xp",
    "../../common/lwIP.0.8xv",
    "../../common/lwIP.1.8xv",
    "../../common/lwIP.2.8xv",
    "../../common/lwIP.3.8xv",
    "../../common/lwIP.4.8xv",
    "../../common/lwIP.5.8xv",
    "../../common/lwip.8xv"
  ],
  "target": {
    "name": "XURL",
    "isASM": true
  },
  "sequence": [
    "key|clear",
    "key|2nd",
    "key|0",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|enter",
    "key|prgm",
    "key|1",
    "key|enter",
    "key|enter",
    "hashWait|7",
    "key|left",
    "key|enter",
    "delay|1000",
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter",
    "hashWait|3",
    "key|enter",
    "hashWait|4",
    "key|enter",
    "hashWait|5",
    "key|enter",
    "hashWait|6",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "Encode: unreserved chars pass through unchanged",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": ["D1F2869F"],
      "timeout": 10000
    },
    "2": {
      "description": "Encode: spaces and special chars become %XX",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": ["D1F2869F"],
      "timeout": 1000
    },
    "3": {
      "description": "Decode: %XX sequences decoded correctly",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": ["D1F2869F"],
      "timeout": 1000
    },
    "4": {
      "description": "Decode: plain string passthrough",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": ["D1F2869F"],
      "timeout": 1000
    },
    "5": {
      "description": "Query string: single key=value pair",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": ["D1F2869F"],
      "timeout": 1000
    },
    "6": {
      "description": "Query string: multiple pairs with encoding",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": ["D1F2869F"],
      "timeout": 1000
    },
    "7": {
      "description": "lwIP installed",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": ["F7C03D8D"],
      "timeout": 100000
    }
  }
}
