{
  "description": "URL percent-encode/decode and query string builder correctness",
  "transfer_files": [
    "bin/XURL.8xp"
  ],
  "target": {
    "name": "XURL",
    "isASM": true
  },
  "sequence": [
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter",
    "hashWait|3",
    "key|enter",
    "hashWait|4",
    "key|enter",
    "hashWait|5",
    "key|enter",
    "hashWait|6",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "Encode: unreserved chars pass through unchanged",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 30000
    },
    "2": {
      "description": "Encode: spaces and special chars become %XX",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "3": {
      "description": "Decode: %XX sequences decoded correctly",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "4": {
      "description": "Decode: plain string passthrough",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "5": {
      "description": "Query string: single key=value pair",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    },
    "6": {
      "description": "Query string: multiple pairs with encoding",
      "start": "vram_start",
      "size": "vram_16_size",
      "label": "@success",
      "expected_CRCs": [
        "D1F2869F"
      ],
      "timeout": 10000
    }
  }
}
