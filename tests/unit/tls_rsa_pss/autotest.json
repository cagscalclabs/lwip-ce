{
  "description": "Tests PSS verification primitive standalone",
  "transfer_files": [
    "bin/XPSS.8xp",
    "../../common/lwIPCERT.8xv"
  ],
  "target": {
    "name": "XPSS",
    "isASM": true
  },
  "sequence": [
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "RSA-PSS verify - RFC 8017 against an OpenSSL-generated fixture",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "A2D7C0AB"
      ],
      "timeout": 30000
    },
    "2": {
      "description": "RSA-PSS verify - synthetic TLS 1.3 CertificateVerify-shaped fixture (EMSA-PSS-ENCODE, fixed salt, 2048-bit modulus)",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "C81B8110"
      ],
      "timeout": 10000
    }
  }
}
