{
  "description": "Tests PSS verification primitive standalone",
  "transfer_files": [
    "bin/XPSS.8xp",
     "../../common/clibs.8xg",
    "../../common/lwIPCERT.8xv",
    "../../common/lwIPINST.8xp",
    "../../common/lwIP.0.8xv",
    "../../common/lwIP.1.8xv",
    "../../common/lwIP.2.8xv",
    "../../common/lwIP.3.8xv",
    "../../common/lwIP.4.8xv",
    "../../common/lwIP.5.8xv",
    "../../common/lwip.8xv"
  ],
  "target": {
    "name": "XPSS",
    "isASM": true
  },
  "sequence": [
    "key|clear",
    "key|2nd",
    "key|0",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|enter",
    "key|prgm",
    "key|1",
    "key|enter",
    "key|enter",
    "hashWait|3",
    "key|left",
    "key|enter",
    "delay|1000",
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "RSA-PSS verify - RFC 8017 against an OpenSSL-generated fixture",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "00000000"
      ],
      "timeout": 11000
    },
    "2": {
      "description": "RSA-PSS verify - synthetic TLS 1.3 CertificateVerify-shaped fixture (EMSA-PSS-ENCODE, fixed salt, 2048-bit modulus)",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "A2D7C0AB"
      ],
      "timeout": 10000
    },
    "3": {
      "description": "lwIP installed",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "C81B8110"
      ],
      "timeout": 100000
    }
  }
}
