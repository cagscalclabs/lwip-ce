{
  "transfer_files": [
    "bin/XASN1.8xp",
    "../../common/clibs.8xg",
    "../../common/lwIPCERT.8xv",
    "../../common/lwIPINST.8xp",
    "../../common/LWIP.0.8xv",
    "../../common/LWIP.1.8xv",
    "../../common/LWIP.2.8xv",
    "../../common/LWIP.3.8xv",
