+func TestStubRestoresIXExactlyOnceOnInitFailure(t *testing.T) {
+	stub, err := Stub(StubOptions{
+		Name:    "LWIP",
+		App:     "lwIP",
+		Prefix:  "lwip",
+		Init:    "lwip_init",
+		Exports: []string{"lwip_init"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(stub)
+	want := "call lwip_init\n\tpop hl\n\tpop hl\n\n\tor a, a\n\tjr z, .init_failed\n\tpop ix\n\tld a, 1"
+	if !strings.Contains(text, want) {
+		t.Fatalf("init result must be checked before the success path restores ix:\n%s", text)
+	}
+}
