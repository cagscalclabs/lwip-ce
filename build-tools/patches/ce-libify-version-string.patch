index 6f7eace..2e840d7 100644
--- a/cmd/manifest.go
+++ b/cmd/manifest.go
@@ -5,6 +5,8 @@ import (
 	"fmt"
 	"os"
 	"sort"
+	"strconv"
+	"strings"
 
 	"github.com/BurntSushi/toml"
 	"github.com/spf13/cobra"
@@ -15,6 +17,7 @@ const manifestFile = "ce-libify.toml"
 
 type appBuild struct {
 	Name         string            `toml:"name"`
+	Version      string            `toml:"version"`
 	Init         string            `toml:"init"`
 	Imports      []string          `toml:"imports"`
 	LinkerScript string            `toml:"linker_script"`
@@ -25,6 +28,23 @@ type appBuild struct {
 	Make         map[string]string `toml:"make"`
 }
 
+func parseAppVersion(text string) (string, error) {
+	if text == "" {
+		return text, nil
+	}
+	parts := strings.Split(text, ".")
+	if len(parts) != 3 {
+		return "", fmt.Errorf("app version %q must be MAJOR.MINOR.PATCH", text)
+	}
+	for _, part := range parts {
+		_, err := strconv.ParseUint(part, 10, 8)
+		if err != nil {
+			return "", fmt.Errorf("app version %q must contain three integers from 0 to 255", text)
+		}
+	}
+	return text, nil
+}
+
 type step struct {
 	Run []string `toml:"run"`
 }
