{
  "transfer_files": [
    "bin/X25519.8xp",
    "../common/clibs.8xg",
    "../common/lwIPCERT.8xv",
    "../common/lwIPINST.8xp",
    "../common/lwIP.0.8xv",
    "../common/lwIP.1.8xv",
    "../common/lwIP.2.8xv",
    "../common/lwIP.3.8xv",
    "../common/lwIP.4.8xv",
    "../common/lwIP.5.8xv",
    "../common/lwip.8xv"
  ],
  "target": {
    "name": "X25519",
    "isASM": true
  },
  "sequence": [
    "key|clear",
    "key|2nd",
    "key|0",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|enter",
    "key|prgm",
    "key|1",
    "key|enter",
    "key|enter",
    "hashWait|7",
    "key|left",
    "key|enter",
    "delay|2000",
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter",
    "hashWait|3",
    "key|enter",
    "hashWait|4",
    "key|enter",
    "hashWait|5",
    "key|enter",
    "hashWait|6",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "x25519 RFC 7748, 6.1 - Alice private * Bob public",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "0F2E31E9"
      ],
      "timeout": 120000
    },
    "2": {
      "description": "x25519 RFC 7748, 6.1 - Bob private * Alice public",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "D24850A3"
      ],
      "timeout": 90000
    },
    "3": {
      "description": "x25519 RFC 7748, 6.1 - Alice pubkey gen",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "0F15BA35"
      ],
      "timeout": 90000
    },
    "4": {
      "description": "x25519 RFC 7748, 5.2 - one iteration (k=9, u=9)",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "38FD2513"
      ],
      "timeout": 90000
    },
    "5": {
      "description": "x25519 RFC 7748 - Edge case, clamping test",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "0BEE81DC"
      ],
      "timeout": 90000
    },
    "6": {
      "description": "x25519 RFC 7748 - Edge case, high bit test",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "1CFDDA02"
      ],
      "timeout": 90000
    },
    "7": {
      "description": "lwIP installed",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "F7C03D8D"
      ],
      "timeout": 100000
    }
  }
}
