{
  "description": "Truststore signature verification and first-entry owner check",
  "transfer_files": [
    "bin/XTRUST.8xp",
    "../common/clibs.8xg",
    "../common/lwIPCERT.8xv",
    "../common/lwIPINST.8xp",
    "../common/lwIP.0.8xv",
    "../common/lwIP.1.8xv",
    "../common/lwIP.2.8xv",
    "../common/lwIP.3.8xv",
    "../common/lwIP.4.8xv",
    "../common/lwIP.5.8xv",
    "../common/lwip.8xv"
  ],
  "target": {
    "name": "XTRUST",
    "isASM": true
  },
  "sequence": [
    "key|clear",
    "key|2nd",
    "key|0",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|down",
    "key|enter",
    "key|prgm",
    "key|1",
    "key|enter",
    "key|enter",
    "hashWait|3",
    "key|left",
    "key|enter",
    "delay|2000",
    "action|launch",
    "hashWait|1",
    "key|enter",
    "hashWait|2",
    "key|enter"
  ],
  "hashes": {
    "1": {
      "description": "Verify truststore signature",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "A440D5E5"
      ],
      "timeout": 30000
    },
    "2": {
      "description": "Verify first entry expected",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "BBA2725D"
      ],
      "timeout": 2000
    },
    "3": {
      "description": "lwIP installed",
      "start": "vram_start",
      "size": "vram_16_size",
      "expected_CRCs": [
        "F7C03D8D"
      ],
      "timeout": 100000
    }
  }
}
