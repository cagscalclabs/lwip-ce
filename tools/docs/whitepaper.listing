		
		#include <string.h>
		#include <fileioc.h>
		#include <cryptx.h>
		
		// open the file
		uint8_t file = ti_OpenVar("KEYFILE", "r", OS_TYPE_PROT_PRGM);
		if(!file) return;
		
		// get decoded length and allocate the memory
		size_t olen = cryptx_base64_get_decoded_len(ti_GetSize(file));
		uint8_t obuf[olen];
		
		// decode the file
		cryptx_base64_decode(obuf, ti_GetDataPtr(file), ti_GetSize(file));
		ti_Close(file);
	
